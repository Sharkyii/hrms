{
  "name": "hrms-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:frontend && wrangler deploy",
    "build:frontend": "cd frontend && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hrms-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hrms-db --remote",
    "seed:generate": "node scripts/generate-seed.ts",
    "seed:local": "wrangler d1 execute hrms-db --local --file=./seed/seed.sql",
    "seed:remote": "wrangler d1 execute hrms-db --remote --file=./seed/seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "pdf-lib": "^1.17.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.121.0"
  }
}
